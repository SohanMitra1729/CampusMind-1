# CampusMind — Environment Variables Template
# Copy this file to .env and fill in your values.
# The .env file is NEVER committed to git.
#
# Usage:
#   cp .env.example .env      # Mac/Linux
#   copy .env.example .env    # Windows

# ── AI APIs ────────────────────────────────────────────────────────────────────
# Get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Get from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ── Supabase ───────────────────────────────────────────────────────────────────
# Get from your Supabase project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── Student Telegram Bot ───────────────────────────────────────────────────────
# Create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_student_bot_token_here

# Your ngrok HTTPS URL (run: ngrok http 8000, then copy the URL)
TELEGRAM_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app/api/telegram/webhook

# ── Staff Telegram Bot ─────────────────────────────────────────────────────────
# Create a second bot via @BotFather on Telegram
STAFF_BOT_TOKEN=your_staff_bot_token_here
STAFF_BOT_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app/api/staff/telegram/webhook

# ── Frontend ───────────────────────────────────────────────────────────────────
# Used by the backend for CORS and password-reset redirect URL
FRONTEND_URL=http://localhost:5173

# ── Admin Panel ────────────────────────────────────────────────────────────────
# Credentials for the /api/admin/auth endpoint.
# ADMIN_SECRET is used as both the password AND the Bearer token for all
# /api/admin/* requests — make this long and random (e.g. openssl rand -hex 32)
ADMIN_USERNAME=admin
ADMIN_SECRET=change_me_to_a_strong_random_secret
